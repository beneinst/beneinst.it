	<entry>
		<title>Sino Polis</title>
		<link rel="alternate" type="text/html" href="http://192.168.178.46/in-italiano/sino-polis.html"/>
		<published>2023-10-02T19:30:10+00:00</published>
		<updated>2023-10-02T19:30:10+00:00</updated>
		<id>http://192.168.178.46/in-italiano/sino-polis.html</id>
		<author>
			<name>Un racconto frammentario sull’incertezza, sull’identità e sulle ombre della vita contemporanea.</name>
		</author>
		<summary type="html">&lt;!--
