	<entry>
		<title>Essere e possedere</title>
		<link rel="alternate" type="text/html" href="http://192.168.178.46/in-italiano/codici-enigmatici-equilibri-oscillanti.html"/>
		<published>2023-10-02T19:31:46+00:00</published>
		<updated>2023-10-02T19:31:46+00:00</updated>
		<id>http://192.168.178.46/in-italiano/codici-enigmatici-equilibri-oscillanti.html</id>
		<author>
			<name>Possedere può colmare uno spazio; soltanto l’essere può dargli un significato.</name>
		</author>
		<summary type="html">&lt;!--
