	<entry>
		<title>Te lo colorerei</title>
		<link rel="alternate" type="text/html" href="http://192.168.178.46/in-italiano/te-lo-colorerei.html"/>
		<published>2023-10-02T19:31:46+00:00</published>
		<updated>2023-10-02T19:31:46+00:00</updated>
		<id>http://192.168.178.46/in-italiano/te-lo-colorerei.html</id>
		<author>
			<name>Una lettera alla vita attraversata da riferimenti letterari, inquietudini sociali e ricerca di autenticità.</name>
		</author>
		<summary type="html">&lt;!--
