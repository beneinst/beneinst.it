	<entry>
		<title>Per ch’è sempre</title>
		<link rel="alternate" type="text/html" href="http://192.168.178.46/in-italiano/per-che-sempre.html"/>
		<published>2023-10-02T19:32:25+00:00</published>
		<updated>2023-10-02T19:32:25+00:00</updated>
		<id>http://192.168.178.46/in-italiano/per-che-sempre.html</id>
		<author>
			<name>Una composizione sul futuro, sulle scelte individuali e sui segreti che attraversano la vita.</name>
		</author>
		<summary type="html">&lt;!--
