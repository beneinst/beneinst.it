	<entry>
		<title>Mercurio, io e tu</title>
		<link rel="alternate" type="text/html" href="http://192.168.178.46/in-italiano/mercurio-io-e-tu.html"/>
		<published>2023-10-02T19:30:55+00:00</published>
		<updated>2023-10-02T19:30:55+00:00</updated>
		<id>http://192.168.178.46/in-italiano/mercurio-io-e-tu.html</id>
		<author>
			<name>Un percorso di immagini e pensieri tra vita quotidiana, memoria e percezione della realtà.</name>
		</author>
		<summary type="html">&lt;!--
