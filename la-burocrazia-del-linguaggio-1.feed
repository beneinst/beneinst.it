	<entry>
		<title>Il telefono guasto</title>
		<link rel="alternate" type="text/html" href="http://192.168.178.46/in-italiano/osserva-il-danzar-dei-sogni-eclissati.html"/>
		<published>2023-10-02T19:32:25+00:00</published>
		<updated>2023-10-02T19:32:25+00:00</updated>
		<id>http://192.168.178.46/in-italiano/osserva-il-danzar-dei-sogni-eclissati.html</id>
		<author>
			<name>Quando il contatto si interrompe, non sappiamo più se il guasto sia nel telefono, nelle parole o nella distanza fra noi.</name>
		</author>
		<summary type="html">&lt;!--
