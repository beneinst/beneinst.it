	</entry>
	<entry>
		<title>Le parole che non si possono usare</title>
		<link rel="alternate" type="text/html" href="http://192.168.178.46/in-italiano/le-parole-che-non-si-possono-usare.html"/>
		<published>2023-10-02T19:29:03+00:00</published>
		<updated>2023-10-02T19:29:03+00:00</updated>
		<id>http://192.168.178.46/in-italiano/le-parole-che-non-si-possono-usare.html</id>
		<author>
			<name>Uno scritto sulla memoria, sulla coscienza e sui limiti imposti alla possibilità di esprimersi.</name>
		</author>
		<summary type="html">&lt;!--
