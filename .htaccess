# ----------------------------------------------------------------------
# 1. REINDIRIZZAMENTI PERSONALIZZATI (301 e 410)
# ----------------------------------------------------------------------
# Reindirizzamento Home Page index.html -> Root
Redirect 301 /index.html https://beneinst.eu/

# Reindirizzamenti specifici per vecchi URL
Redirect 301 /index28ef.html https://beneinst.eu/e-book-gratis.html

# Se desideri restituire 410 Gone per pagine eliminate definitivamente:
# Redirect 410 /vecchia-pagina-eliminata.html
# Pagine eliminate definitivamente (Codice 410 Gone)
Redirect 410 /emily-dickinson.html
Redirect 410 /fyodor-tyutchev.html
Redirect 410 /fedro.html
Redirect 410 /indexff2b.html
Redirect 410 /index306c.html
Redirect 410 /di-luigi-cardarellib5c2.html
Redirect 410 /di-salvatore-messina3204.html
Redirect 410 /di-franco-bazzarellib620.html
Redirect 410 /di-franco-bazzarelli4047.html

# ----------------------------------------------------------------------
# 2. REGOLE STANDARD DI JOOMLA (Routing e SEF)
# ----------------------------------------------------------------------
RewriteEngine On

# Imposta la directory base (lascia / se il sito è nella root)
RewriteBase /

# Blocco degli attacchi comuni e protezione file
RewriteCond %{QUERY_STRING} base64_encode[^(]*\([^)]*\) [OR]
RewriteCond %{QUERY_STRING} (<|%3C)([^s]*s)+cript.*(>|%3E) [NC,OR]
RewriteCond %{QUERY_STRING} GLOBALS(=|\[|\%20) [OR]
RewriteCond %{QUERY_STRING} _REQUEST(=|\[|\%20)
RewriteRule .* index.php [F]

# Reindirizza le richieste a index.php se non si tratta di file o cartelle reali
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/index\.php
RewriteRule .* index.php [L]